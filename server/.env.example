# Studio Lite Roblox proxy — server-side credentials ONLY. Never commit the real .env.
# Copy this file to `.env` and fill the values you have. All are optional; without any
# credential the proxy still returns thumbnails and public asset content, but Creator Store
# search and most post-2024 asset content require a key.

# Open Cloud API key (Creator Hub > Open Cloud > API Keys).
# Needed for: Creator Store search, asset delivery via apis.roblox.com.
# Recommended scopes/permissions: creator-store-product:read and legacy asset read.
ROBLOX_API_KEY=

# Optional .ROBLOSECURITY cookie value (an account that can access the assets).
# Only used server-side as a fallback for asset delivery / legacy details. Leave empty if unsure.
ROBLOX_COOKIE=

# Port the proxy listens on (frontend expects this; keep in sync with app/roblox/config).
PORT=8787

# Comma-separated list of allowed browser origins for CORS. "*" allows any (dev only).
ALLOWED_ORIGINS=*

# Request timeout to Roblox, in milliseconds.
ROBLOX_TIMEOUT_MS=15000
